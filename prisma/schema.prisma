generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  OWNER
  MANAGER
  CASHIER
  KITCHEN
  STAFF
}
enum OrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  READY
  COMPLETED
  CANCELLED
}
enum OrderType {
  DINE_IN
  TAKEAWAY
  DELIVERY
}
enum PaymentStatus {
  UNPAID
  PAID
  PARTIALLY_REFUNDED
  REFUNDED
}
enum ReservationStatus {
  BOOKED
  SEATED
  COMPLETED
  CANCELLED
  NO_SHOW
}
enum PaymentProvider {
  RAZORPAY
  CASH
  CARD
  UPI
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole @default(STAFF)
  locationId   String?
  location     Location? @relation(fields: [locationId], references: [id])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Location {
  id           String          @id @default(cuid())
  name         String
  timezone     String          @default("Asia/Kolkata")
  currency     String          @default("INR")
  users        User[]
  categories   Category[]
  orders       Order[]
  tables       DiningTable[]
  inventory    InventoryItem[]
  customers    Customer[]
  reservations Reservation[]
  createdAt    DateTime        @default(now())
}

model Category {
  id         String     @id @default(cuid())
  name       String
  sortOrder  Int        @default(0)
  locationId String
  location   Location   @relation(fields: [locationId], references: [id], onDelete: Cascade)
  items      MenuItem[]
  @@unique([locationId, name])
}

model MenuItem {
  id          String      @id @default(cuid())
  name        String
  description String?
  price       Decimal     @db.Decimal(10, 2)
  isAvailable Boolean     @default(true)
  categoryId  String
  category    Category    @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  orderItems  OrderItem[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model DiningTable {
  id           String        @id @default(cuid())
  label        String
  capacity     Int           @default(2)
  qrCode       String?       @unique
  locationId   String
  location     Location      @relation(fields: [locationId], references: [id], onDelete: Cascade)
  orders       Order[]
  reservations Reservation[]
  @@unique([locationId, label])
}

model Customer {
  id         String   @id @default(cuid())
  name       String
  phone      String?
  email      String?
  locationId String
  location   Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  orders     Order[]
  createdAt  DateTime @default(now())
  @@unique([locationId, phone])
}

model Order {
  id            String        @id @default(cuid())
  orderNumber   Int
  type          OrderType     @default(DINE_IN)
  status        OrderStatus   @default(PENDING)
  paymentStatus PaymentStatus @default(UNPAID)
  subtotal      Decimal       @db.Decimal(10, 2)
  tax           Decimal       @default(0) @db.Decimal(10, 2)
  discount      Decimal       @default(0) @db.Decimal(10, 2)
  total         Decimal       @db.Decimal(10, 2)
  notes         String?
  locationId    String
  location      Location      @relation(fields: [locationId], references: [id], onDelete: Cascade)
  tableId       String?
  table         DiningTable?  @relation(fields: [tableId], references: [id])
  customerId    String?
  customer      Customer?     @relation(fields: [customerId], references: [id])
  items         OrderItem[]
  payments      Payment[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  @@unique([locationId, orderNumber])
  @@index([locationId, status, createdAt])
}

model OrderItem {
  id         String   @id @default(cuid())
  orderId    String
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItemId String
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id])
  quantity   Int      @default(1)
  unitPrice  Decimal  @db.Decimal(10, 2)
  notes      String?
}

model InventoryItem {
  id           String          @id @default(cuid())
  name         String
  unit         String
  quantity     Decimal         @db.Decimal(12, 3)
  reorderLevel Decimal         @default(0) @db.Decimal(12, 3)
  locationId   String
  location     Location        @relation(fields: [locationId], references: [id], onDelete: Cascade)
  movements    StockMovement[]
  updatedAt    DateTime        @updatedAt
  @@unique([locationId, name])
}

model StockMovement {
  id              String        @id @default(cuid())
  inventoryItemId String
  inventoryItem   InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)
  quantityDelta   Decimal       @db.Decimal(12, 3)
  reason          String
  createdAt       DateTime      @default(now())
}

model Reservation {
  id         String            @id @default(cuid())
  guestName  String
  phone      String?
  partySize  Int
  startsAt   DateTime
  status     ReservationStatus @default(BOOKED)
  tableId    String?
  table      DiningTable?      @relation(fields: [tableId], references: [id])
  locationId String
  location   Location          @relation(fields: [locationId], references: [id], onDelete: Cascade)
  notes      String?
  createdAt  DateTime          @default(now())
  @@index([locationId, startsAt, status])
}

model Payment {
  id                String          @id @default(cuid())
  orderId           String
  order             Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider          PaymentProvider
  providerOrderId   String?         @unique
  providerPaymentId String?         @unique
  amount            Decimal         @db.Decimal(10, 2)
  currency          String          @default("INR")
  status            String          @default("CREATED")
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
}
